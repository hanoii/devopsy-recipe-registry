#!/bin/sh
## Description: Print the registry's URL, user and password for docker login
set -eu
env_file="$DEVOPSY_PROJECT_DIR/.env"
host="${DEVOPSY_WILDCARD_HOST:-app.localhost}"
user="$(sed -n 's/^REGISTRY_USER=//p' "$env_file" 2>/dev/null | tail -n 1)"
password="$(sed -n 's/^REGISTRY_PASSWORD=//p' "$env_file" 2>/dev/null | tail -n 1)"
if [ -z "$password" ]; then
  echo "credentials: no REGISTRY_PASSWORD in .env yet: run deploy first" >&2
  exit 1
fi
echo "registry: $host"
echo "user:     ${user:-devopsy}"
echo "password: $password"
echo
echo "docker login $host -u ${user:-devopsy} --password-stdin"
