#!/bin/sh
## Description: Start or update the registry (run on the server by release)
# The environments' release and rollback run step (config.yaml), run on the
# server by `devopsy @<target> --release` and `--rollback`; or locally.
#
# It generates missing secrets first (secrets). Every run writes
# mnt/auth/htpasswd when it does not match REGISTRY_USER and
# REGISTRY_PASSWORD, so changing the password in .env and deploying applies it.
set -eu

env_file="$DEVOPSY_PROJECT_DIR/.env"
auth_dir="$DEVOPSY_PROJECT_DIR/mnt/auth"

# Secrets first, as the release's prepare step already did: for local use.
devopsy secrets

# The values as written in .env: they were just generated, or set by hand
# (keep them unquoted).
user="$(sed -n 's/^REGISTRY_USER=//p' "$env_file" | tail -n 1)"
user="${user:-devopsy}"
password="$(sed -n 's/^REGISTRY_PASSWORD=//p' "$env_file" | tail -n 1)"

devopsy pull --quiet registry init htpasswd

# The password goes through stdin, never the command line. A running registry
# restarts to read a new file.
running="$(devopsy ps -q registry 2>/dev/null)"
changed=
mkdir -p "$auth_dir"
if ! printf '%s\n' "$password" | devopsy run --rm -T -v "$auth_dir:/auth:ro" htpasswd -v -i /auth/htpasswd "$user" >/dev/null 2>&1; then
  printf '%s\n' "$password" | devopsy run --rm -T htpasswd -n -i -B "$user" 2>/dev/null > "$auth_dir/htpasswd.new"
  mv "$auth_dir/htpasswd.new" "$auth_dir/htpasswd"
  echo "deploy: wrote mnt/auth/htpasswd for $user" >&2
  changed=1
fi

devopsy up -d --wait --remove-orphans
if [ -n "$changed" ] && [ -n "$running" ]; then
  devopsy restart registry
fi
echo "deploy: ${SITE_URL:-no URL: no wildcard domain or DEVOPSY_DOMAINS}" >&2
